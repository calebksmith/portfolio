# Copy to .env.local and fill in. Never commit .env.local.
# Each variable is read through lib/env.ts, which fails with a useful message
# if one is missing.

# --- Database -----------------------------------------------------------------
# Neon pooled connection string, from the Neon dashboard.
# https://console.neon.tech -> your project -> Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL (dev):  http://localhost:3000/api/auth/callback/github
# Authorization callback URL (prod): https://your-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated GitHub logins allowed into /admin.
# This is the authorization boundary — GitHub proves identity, this decides access.
ADMIN_GITHUB_LOGINS="your-github-username"

# --- Misc ---------------------------------------------------------------------
# Any long random string. Salts the hashed visitor IPs in the CV view log;
# rotating it resets repeat-view detection.
VISITOR_HASH_SALT=""

# --- Gated screenshots ----------------------------------------------------------
# Signs the personal access links (npm run access:link). The same value here and
# in Vercel. Any long random string: openssl rand -base64 32. Rotating it
# revokes every link at once.
ACCESS_SECRET=""

# Optional. Access-link ids that no longer work, comma-separated. `npm run
# access:revoke` prints the value to set; it takes effect on the next deploy.
ACCESS_REVOKED=""

# The private Blob store's read-write token, from the store's page in Vercel.
# Needed locally only to upload (npm run media:upload). Connecting the store to
# the project sets it in Vercel.
BLOB_READ_WRITE_TOKEN=""
