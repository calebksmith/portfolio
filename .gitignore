# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents required config.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.lighthouseci/

# Claude Code: personal permissions and machine paths. Never commit.
.claude/settings.local.json

# Reference material from an employer or client. Read it, never commit it.
/private/
