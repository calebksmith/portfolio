{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 4173",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/work/vimui",
        "http://localhost:4173/experience",
        "http://localhost:4173/colophon",
        "http://localhost:4173/style-guide"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
